{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动电子电容平台",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "jinja": true,
      "env": {"PYTHONIOENCODING": "utf-8", "PYTHONDONTWRITEBYTECODE": "1", "HOST": "127.0.0.1", "PORT": "5001"}
    },
    {
      "name": "检查网站环境与资源",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "args": ["--check"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
