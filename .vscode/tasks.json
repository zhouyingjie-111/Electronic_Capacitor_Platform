{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "安装网站依赖（首次运行）",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/d", "/c", "安装依赖.bat"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "网站启动自检",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["run.py", "--check"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
