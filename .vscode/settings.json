{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["./webapp", "./webapp/vendor_public"],
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-v", "-s", "./webapp/tests", "-p", "test_*.py"],
  "files.encoding": "utf8",
  "files.exclude": {"**/__pycache__": true},
  "search.exclude": {"**/runtime": true, "**/.venv": true, "**/wheels": true}
}
