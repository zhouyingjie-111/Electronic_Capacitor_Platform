# Cross-platform text checkout; Windows launch scripts retain CRLF.
* text=auto eol=lf
*.bat text eol=crlf
# Preserve raw measurement bytes and saved dataset SHA-256 fingerprints.
*.csv -text
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.slx binary
*.npz binary
*.npy binary
*.onnx binary
*.h5 binary
*.keras binary
*.a binary
*.lib binary
*.whl binary

# Preserve the supplied CCS source encoding, line endings and prebuilt model libraries.
firmware/PI_ANN_CNN_SCI_CPU/** -text
firmware/PI_ANN_CNN_SCI_NPU/** -text
